import { Ionicons } from "@expo/vector-icons";
import dayjs from "dayjs";
import { Image } from "expo-image";
import { useRouter, useFocusEffect } from "expo-router";
import React, {
  useEffect,
  useState,
  useCallback,
} from "react";
import {
  ScrollView,
  StyleSheet,
  Text,
  TouchableOpacity,
  View,
} from "react-native";
import { SafeAreaView } from "react-native-safe-area-context";
import * as Print from "expo-print";
import * as Sharing from "expo-sharing";

import { partnerApi } from "../lib/api";

// =========================================================
// TYPES
// =========================================================

type CancelledBooking = {
  id: string;
  customer_name: string;
  services: any[];
  cancellation_fee: number;
  cancellation_reason: string;
  cancelled_at: string;
  booking_date: string;
};

// =========================================================
// SCREEN
// =========================================================

export default function CancellationsScreen() {
  const router = useRouter();

  const [data, setData] = useState<CancelledBooking[]>([]);
  const [totalFee, setTotalFee] = useState(0);
  const [loading, setLoading] = useState(true);

  // =======================================================
  // FETCH CANCELLED BOOKINGS
  // =======================================================

  const fetchCancelledData = async () => {
    setLoading(true);

    try {
      // ---------------------------------------------------
      // Get cancelled bookings through FastAPI
      // ---------------------------------------------------

      const response: any =
  await partnerApi.bookings("cancelled");

const bookings = Array.isArray(response?.data)
  ? response.data
  : [];
      // ---------------------------------------------------
      // Convert backend response to screen data
      // ---------------------------------------------------

      const list: CancelledBooking[] = bookings.map(
        (item: any) => ({
          id: item.id,

          customer_name:
            item.customer_name ||
            "Customer",

          services:
            Array.isArray(item.services)
              ? item.services
              : [],

          // IMPORTANT:
          // Use actual cancellation fee from backend.
          // No hard-coded ₹99.
          cancellation_fee:
            Number(
              item.cancellation_fee ?? 0
            ),

          // Backend booking column is cancel_reason.
          cancellation_reason:
            item.cancel_reason ||
            "Partner Cancelled",

          // Backend booking column is cancel_time.
          cancelled_at:
            item.cancel_time ||
            item.updated_at ||
            item.created_at ||
            new Date().toISOString(),

          booking_date:
            item.booking_date ||
            "",
        })
      );

      setData(list);

      // ---------------------------------------------------
      // Calculate total cancellation fee
      // ---------------------------------------------------

      const sum = list.reduce(
        (total, item) =>
          total +
          Number(item.cancellation_fee || 0),
        0
      );

      setTotalFee(sum);
    } catch (error) {
      console.log(
        "CANCELLATION API ERROR:",
        error
      );

      setData([]);
      setTotalFee(0);
    } finally {
      setLoading(false);
    }
  };

  // =======================================================
  // INITIAL LOAD
  // =======================================================

  useEffect(() => {
    fetchCancelledData();
  }, []);

  // =======================================================
  // REFRESH WHEN SCREEN GETS FOCUS
  // =======================================================

  useFocusEffect(
    useCallback(() => {
      fetchCancelledData();
    }, [])
  );

  // =======================================================
  // GENERATE PDF
  // =======================================================

  const generatePDF = async () => {
    try {
      const rows = data
        .map(
          (item) => `
        <tr>
          <td>${item.customer_name}</td>
          <td>${item.cancellation_reason}</td>
          <td>₹${item.cancellation_fee}</td>
          <td>
            ${dayjs(item.cancelled_at).format(
              "DD MMM YYYY"
            )}
          </td>
        </tr>
      `
        )
        .join("");

      const html = `
      <html>
        <body
          style="
            font-family: Arial;
            padding: 20px;
          "
        >
          <h1
            style="
              text-align:center;
              color:#b91c1c;
            "
          >
            Cancellation Report
          </h1>

          <h2
            style="
              color:#991b1b;
            "
          >
            Total Cancellation Fee: ₹${totalFee}
          </h2>

          <table
            width="100%"
            border="1"
            cellspacing="0"
            cellpadding="8"
            style="
              border-collapse:collapse;
              margin-top:20px;
            "
          >
            <thead>
              <tr
                style="
                  background-color:#fee2e2;
                  color:#991b1b;
                "
              >
                <th>Customer</th>
                <th>Reason</th>
                <th>Fee Charged</th>
                <th>Date</th>
              </tr>
            </thead>

            <tbody>
              ${rows}
            </tbody>
          </table>
        </body>
      </html>
    `;

      const { uri } =
        await Print.printToFileAsync({
          html,
        });

      await Sharing.shareAsync(uri, {
        mimeType: "application/pdf",
        dialogTitle:
          "Cancellation Report",
      });
    } catch (error) {
      console.log(
        "PDF ERROR:",
        error
      );
    }
  };

  // =======================================================
  // UI
  // =======================================================

  return (
    <SafeAreaView
      style={{
        flex: 1,
        backgroundColor: "#fff",
      }}
    >
      {/* =================================================
          HEADER
      ================================================= */}

      <View style={styles.header}>
        <TouchableOpacity
          onPress={() =>
            router.replace("/my-role")
          }
        >
          <Image
            source={require("../assets/images/logo.png")}
            style={styles.logo}
            contentFit="contain"
          />
        </TouchableOpacity>

        <TouchableOpacity
          onPress={() =>
            router.canGoBack()
              ? router.back()
              : router.replace("/dashboard")
          }
        >
          <Ionicons
            name="arrow-back"
            size={24}
            color="#000"
          />
        </TouchableOpacity>
      </View>

      {/* =================================================
          CONTENT
      ================================================= */}

      <ScrollView
        style={{ flex: 1 }}
        contentContainerStyle={{
          padding: 16,
          paddingBottom: 120,
        }}
        showsVerticalScrollIndicator={false}
      >
        {/* =================================================
            TOTAL CANCELLATION FEE
        ================================================= */}

        <Text style={styles.totalText}>
          Total Cancellation Fee: ₹{totalFee}
        </Text>

        {/* =================================================
            LOADING
        ================================================= */}

        {loading ? (
          <Text
            style={{
              textAlign: "center",
              marginTop: 40,
            }}
          >
            Loading...
          </Text>
        ) : data.length === 0 ? (
          /* ===============================================
             EMPTY STATE
          =============================================== */

          <Text
            style={{
              textAlign: "center",
              marginTop: 40,
              color: "gray",
            }}
          >
            No cancelled services
          </Text>
        ) : (
          /* ===============================================
             CANCELLED BOOKINGS
          =============================================== */

          data.map((item, i) => (
            <View
              key={item.id || i}
              style={styles.card}
            >
              {/* =========================================
                  CUSTOMER + FEE
              ========================================= */}

              <View style={styles.cardRow}>
                <Text
                  style={
                    styles.customerName
                  }
                >
                  {item.customer_name}
                </Text>

                <Text
                  style={styles.feeText}
                >
                  Fee: ₹
                  {item.cancellation_fee}
                </Text>
              </View>

              {/* =========================================
                  SERVICES
              ========================================= */}

              {item.services &&
                item.services.length > 0 && (
                  <View
                    style={
                      styles.servicesBox
                    }
                  >
                    {item.services.map(
                      (
                        service: any,
                        idx: number
                      ) => (
                        <Text
                          key={idx}
                          style={
                            styles.serviceItem
                          }
                        >
                          •{" "}
                          {service?.title ||
                            service?.name ||
                            String(
                              service
                            )}
                        </Text>
                      )
                    )}
                  </View>
                )}

              {/* =========================================
                  CANCELLATION REASON
              ========================================= */}

              <Text
                style={
                  styles.reasonText
                }
              >
                <Text
                  style={{
                    fontWeight: "700",
                  }}
                >
                  Reason:
                </Text>{" "}
                {item.cancellation_reason}
              </Text>

              {/* =========================================
                  CANCELLATION DATE
              ========================================= */}

              <Text
                style={styles.dateText}
              >
                Cancelled on:{" "}
                {dayjs(
                  item.cancelled_at
                ).format(
                  "DD MMM YYYY, hh:mm A"
                )}
              </Text>

              {/* =========================================
                  BOOKING DATE
              ========================================= */}

              {item.booking_date ? (
                <Text
                  style={
                    styles.bookingDateText
                  }
                >
                  Booking date:{" "}
                  {dayjs(
                    item.booking_date
                  ).format(
                    "DD MMM YYYY"
                  )}
                </Text>
              ) : null}

              {/* =========================================
                  AMOUNT DEDUCTED
              ========================================= */}

              <View
                style={
                  styles.deductionBox
                }
              >
                <Text
                  style={
                    styles.deductionLabel
                  }
                >
                  Amount Deducted
                </Text>

                <Text
                  style={
                    styles.deductionAmount
                  }
                >
                  ₹
                  {item.cancellation_fee}
                </Text>
              </View>
            </View>
          ))
        )}
      </ScrollView>

      {/* =================================================
          DOWNLOAD REPORT
      ================================================= */}

      {data.length > 0 && (
        <TouchableOpacity
          style={
            styles.floatingDownloadBtn
          }
          onPress={generatePDF}
        >
          <Ionicons
            name="download-outline"
            size={26}
            color="#991b1b"
          />

          <Text
            style={
              styles.floatingDownloadText
            }
          >
            Download Report
          </Text>
        </TouchableOpacity>
      )}
    </SafeAreaView>
  );
}

// =========================================================
// STYLES
// =========================================================

const styles = StyleSheet.create({
  header: {
    height: 60,
    flexDirection: "row",
    alignItems: "center",
    justifyContent:
      "space-between",
    paddingHorizontal: 16,
  },

  logo: {
    width: 190,
    height: 64,
  },

  totalText: {
    fontSize: 20,
    fontWeight: "bold",
    marginBottom: 16,
    color: "#b91c1c",
  },

  card: {
    backgroundColor: "#fff",
    padding: 14,
    borderRadius: 14,
